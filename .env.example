# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# VITE_CLOUDBASE_ENV_ID: Tencent CloudBase Environment ID
VITE_CLOUDBASE_ENV_ID="your-env-id"

# VITE_CLOUDBASE_REGION: Tencent CloudBase Region (e.g., ap-shanghai, ap-guangzhou)
VITE_CLOUDBASE_REGION="ap-shanghai"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# GLM_API_KEY: Required for GLM AI API calls.
# This key must be set as an environment variable in the Tencent CloudBase cloud
# functions (glm-proxy and weekly-matching) via the CloudBase console or
# cloudbaserc.json. It should NEVER be exposed to the browser.
# GLM_API_KEY="MY_GLM_API_KEY"  <-- set only in the cloud function config, not here
